# ==========================================
# GitHub Profile Repository - .gitignore
# ==========================================

# Dependencies
node_modules/
vendor/

# Build outputs
dist/
build/
*.min.js
*.min.css

# Environment files
.env
.env.local
.env.*.local
!.env.example

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
coverage/
.nyc_output/
*.lcov

# Cache
.cache/
.eslintcache
.stylelintcache
.pnp
.pnp.js

# OS
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp
.tmp/
temp/

# Docker
.docker/

# Terraform
*.tfstate
*.tfstate.*
.terraform/

# Misc
*.pem
.vercel
.netlify

# GitHub Actions (local)
.github/workflows/*.yml.bak
.github/workflows/*.yaml.bak

# Profile specific (optional - keep if you want to track)
# .github/profile/README.md.bak